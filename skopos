#!/usr/bin/env node
'use strict';

// skopos — Observe. Reason. Deliver.
// One global install that enhances whatever AI CLI is in use.
//
// Deterministic plumbing only: the CLI renders everything from
// ~/.skopos/config.json; judgement (identity, tone, repo registry) is gathered
// by the skopos-setup interview skill, which writes that config.

const path = require('path');
const {
  SKOPOS_VERSION, runInstall, runVerify, runUninstall, runStatus, runSourcesSync, runConfigValidate,
  runModelsList, runModelsCheck, runModelsSignal, runModelsMatrix,
  runSorAuth, runSorTest, runSorPublish, runSorList, runSorRead,
} = require('./lib/commands');
const configLib = require('./lib/config');
const { resolveEnv, exists, readText, safeJson } = require('./lib/util');
const lockLib = require('./lib/lock');
const c = require('./lib/colors');
const fmt = require('./lib/formatting');

const skoposRoot = __dirname;

function parseArgs(argv) {
  const args = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--dry-run') args.dryRun = true;
    else if (a === '--force') args.force = true;
    else if (a === '--target') args.target = argv[++i];
    else if (a === '--family') args.family = argv[++i];
    else if (a === '--help' || a === '-h') args.help = true;
    else args._.push(a);
  }
  return args;
}

const USAGE = `skopos ${SKOPOS_VERSION} — Observe. Reason. Deliver.

One global install that enhances whatever AI CLI is in use. Content is authored
once (Agent Skills standard, ~/.agents/skills); thin per-tool adapters project
instructions and agents into each tool.

Commands:
  install   [--dry-run] [--force] [--target claude|copilot|all]
      Install/refresh everything. --target enables a surface and persists it
      into config (a later bare \`update\` keeps it). First run with no config
      detects installed tools.
  update    [--dry-run]
      Re-render from current config + synced sources. Targets always come from
      config. Preserves the SKOPOS:USER-FACTS fence; prunes deselected content.
  verify
      Check installed files against the lock. Exit 2 on drift. For files skopos
      only holds a fenced block in, only the block content is checked.
  status
      Version, targets, sources + pinned SHAs, content counts, drift, and any
      pre-existing (user-owned) agents skopos leaves untouched.
  uninstall [--dry-run]
      Remove managed files, strip SKOPOS:MANAGED fences, restore snapshots.
      Your config.json survives.
  sources sync | sources list
      Sync enterprise/approved-content sources (git) and pin SHAs, or list them.
  config validate
      Validate ~/.skopos/config.json (after enterprise-defaults merge).
  models list
      Print the known model capability matrix (informational — see
      docs/model-capabilities.md).
  models check
      Advise whether each rendered agent's resolved model meets its
      declared reasoning/tool-use needs, per enabled target. Informational
      only; never blocks install/update (which run this automatically).
  models signal [<agent>] [--family claude|copilot]
      Print a preference signal (preferred model, fallback chain, rationale)
      for one agent or all of them — for use when delegating work to another
      platform or agent. A signal, not a directive.
  models matrix
      Print the full agent x model compatibility matrix (every known model,
      independent of current config) — see docs/model-capabilities.md.

First run: ./skopos install, then open your AI tool and run the skopos-setup
interview, then ./skopos update.`;

function say(lines) { console.log(lines.filter((l) => l !== null).join('\n')); }
function fail(msg) { console.error(`error: ${msg}`); process.exit(1); }

function reportInstall(r, cmd) {
  const label = { install: 'install', update: 'update' }[cmd] || r.mode;
  const statusText = r.dryRun
    ? c.boldYellow(`◌ skopos ${label} — dry run, nothing written`)
    : c.boldGreen(`✔ skopos ${label} — done`);

  const lines = [];
  lines.push(fmt.header(`SKOPOS ${label.toUpperCase()}`, 'double'));
  lines.push('');
  lines.push(statusText);
  lines.push('');

  if (r.detected.length) lines.push(fmt.keyValue('detected', `${r.detected.join(', ')} → targets enabled (persisted to config)`));
  lines.push(fmt.keyValue('targets', r.targets.join(', ') || 'none'));
  lines.push(fmt.keyValue('skills', `${r.skills.length} → ~/.agents/skills (${r.skills.join(', ') || '-'})`));
  lines.push(fmt.keyValue('templates', `${r.templates.length} → ~/.agents/templates (${r.templates.join(', ') || '-'})`));
  lines.push(fmt.keyValue('agents', `${r.agents.length} per target (${r.agents.join(', ') || '-'})`));

  const ch = r.changes;
  lines.push(fmt.keyValue('files', `${r.managedCount} managed (${ch.added} new, ${ch.updated} updated, ${ch.removed} pruned), ${r.fenced.length} fenced block(s), ${r.links.length} compat link(s)`));

  if (r.snapshotted.length) lines.push(fmt.keyValue('rollback', `${r.snapshotted.length} pre-existing file(s) snapshotted — \`skopos uninstall\` restores them.`));
  if (r.preexisting.length) lines.push(fmt.keyValue('preserved', `(your own, untouched) ${r.preexisting.join(', ')}`));

  if (!r.personalized) {
    lines.push('');
    lines.push(c.cyan('  → Not yet personalized — open your AI tool, run the skopos-setup interview,'));
    lines.push(c.cyan('    then run `skopos update`.'));
  }
  if (r.warnings.length) {
    lines.push('');
    lines.push(c.boldYellow(`  ⚠ Warnings (${r.warnings.length}):`));
    for (const w of r.warnings) lines.push(c.yellow(`    ! ${w}`));
  }
  say(lines);
}

function main() {
  const args = parseArgs(process.argv.slice(2));
  const cmd = args._[0];
  if (args.help || !cmd) { console.log(USAGE); process.exit(args.help ? 0 : 1); }
  const env = resolveEnv();

  try {
    if (cmd === 'install' || cmd === 'update') {
      if (cmd === 'update' && args.target) fail('update takes no --target — targets always come from config (use `skopos install --target …` to enable a new surface).');
      const r = runInstall({ skoposRoot, env, dryRun: args.dryRun, force: args.force, target: args.target, mode: cmd });
      reportInstall(r, cmd);
      process.exit(0);
    }

    if (cmd === 'verify') {
      const r = runVerify({ env });
      const lines = [];
      lines.push(fmt.header('SKOPOS VERIFY', 'double'));
      lines.push('');

      if (r.ok) {
        const n = Object.keys(r.lock.managed || {}).length;
        const f = Object.keys(r.lock.fenced || {}).length;
        lines.push(c.boldGreen(`✔ verify: OK`));
        lines.push(`  ${n} managed file(s) + ${f} fenced block(s) match (skopos ${r.lock.skoposVersion}).`);
        say(lines);
        process.exit(0);
      }

      lines.push(c.boldRed(`✖ verify: DRIFT detected`));
      lines.push(`  (skopos ${r.lock.skoposVersion})`);
      lines.push('');
      if (r.missing.length) {
        lines.push(c.red('  Missing files:'));
        for (const m of r.missing) lines.push(c.red(`    • ${m}`));
      }
      if (r.modified.length) {
        if (r.missing.length) lines.push('');
        lines.push(c.red('  Modified files:'));
        for (const m of r.modified) lines.push(c.red(`    • ${m}`));
      }
      say(lines);
      process.exit(2);
    }

    if (cmd === 'status') {
      const s = runStatus({ env, skoposRoot });
      const installedTag = s.installed
        ? c.green(`yes (lock: skopos ${s.lock.skoposVersion})`)
        : c.yellow('no');

      const lines = [];
      lines.push(fmt.header(`SKOPOS STATUS`, 'double'));
      lines.push('');
      lines.push(c.bold(`skopos ${s.skoposVersion}`));
      lines.push('');
      lines.push(fmt.keyValue('installed', installedTag));
      lines.push(fmt.keyValue('config', s.configExists ? configLib.configPath(env) : 'not written yet (run the skopos-setup interview)'));
      lines.push(fmt.keyValue('targets', s.targets.join(', ') || 'none'));
      lines.push(fmt.keyValue('skills', s.skills.join(', ') || 'none'));
      lines.push(fmt.keyValue('templates', s.templates.join(', ') || 'none'));
      lines.push(fmt.keyValue('agents', s.agents.join(', ') || 'none'));

      const srcs = Object.entries((s.lock && s.lock.sources) || {});
      lines.push('');
      lines.push(fmt.keyValue('sources', srcs.length ? '' : 'none'));
      for (const [name, p] of srcs) {
        lines.push(`    ${c.cyan(name)} @ ${c.dim(p.sha ? p.sha.slice(0, 12) : '?')} (${p.url})`);
      }

      if (s.drift) {
        const driftTag = s.drift.ok
          ? c.green('none')
          : c.yellow(`${s.drift.missing.length} missing, ${s.drift.modified.length} modified — run \`skopos verify\``);
        lines.push('');
        lines.push(fmt.keyValue('drift', driftTag));
      }

      if (s.preexisting.length) {
        lines.push('');
        lines.push(fmt.keyValue('preserved', `(your own) ${s.preexisting.join(', ')}`));
      }

      if (s.warnings.length) {
        lines.push('');
        lines.push(c.boldYellow(`  ⚠ Warnings (${s.warnings.length}):`));
        for (const w of s.warnings) lines.push(c.yellow(`    ! ${w}`));
      }

      say(lines);
      process.exit(0);
    }

    if (cmd === 'uninstall') {
      const r = runUninstall({ env, dryRun: args.dryRun });
      const lines = [];
      lines.push(fmt.header('SKOPOS UNINSTALL', 'double'));
      lines.push('');

      const statusText = r.dryRun
        ? c.boldYellow('◌ skopos uninstall — dry run, nothing written')
        : c.boldGreen('✔ skopos uninstall — done');
      lines.push(statusText);
      lines.push('');
      lines.push(fmt.keyValue('removed', `${r.removed.length} file(s)/link(s)`));
      lines.push(fmt.keyValue('stripped', `${r.stripped.length} fence(s)`));
      lines.push(fmt.keyValue('restored', `${r.restored.length} original(s)`));
      lines.push('');
      lines.push('  Your config.json was left in place.');

      say(lines);
      process.exit(0);
    }

    if (cmd === 'sources') {
      const sub = args._[1];
      if (sub === 'sync') {
        const r = runSourcesSync({ env, skoposRoot });
        const lines = [];
        lines.push(fmt.header('SKOPOS SOURCES SYNC', 'double'));
        lines.push('');

        if (!r.results.length) {
          lines.push('  no sources configured.');
        } else {
          for (const s of r.results) {
            if (s.error) {
              lines.push(c.red(`  ✗ ${s.name}`));
              lines.push(c.red(`    error: ${s.error}`));
              if (s.sha) lines.push(c.yellow(`    (kept prior checkout @ ${s.sha.slice(0, 12)})`));
            } else {
              lines.push(c.green(`  ✓ ${s.name}`));
              lines.push(`    @ ${c.dim(s.sha.slice(0, 12))} (${s.url})`);
            }
          }
        }

        if (r.prunedDirs.length) {
          lines.push('');
          lines.push(c.dim('  Pruned stale checkouts:'));
          for (const p of r.prunedDirs) lines.push(c.dim(`    • ${p}`));
        }

        lines.push('');
        lines.push(fmt.divider('─'));
        lines.push('  Run `skopos update` to install synced content.');

        say(lines);
        process.exit(r.results.some((s) => s.error) ? 1 : 0);
      }
      if (sub === 'list') {
        const loaded = configLib.loadConfig(env, skoposRoot);
        const lock = lockLib.readLock(env);
        const pins = (lock && lock.sources) || {};
        const lines = [];
        lines.push(fmt.header('SKOPOS SOURCES', 'double'));
        lines.push('');
        lines.push('configured sources (config order = precedence, highest first):');
        lines.push('');

        if (!(loaded.config.sources || []).length) {
          lines.push('  none');
        } else {
          for (const s of loaded.config.sources || []) {
            const pin = pins[s.name];
            const statusStr = pin ? c.green(`pinned @ ${pin.sha.slice(0, 12)}`) : c.yellow('not synced');
            lines.push(`  ${c.cyan(s.name)}`);
            lines.push(`    url: ${s.url}`);
            lines.push(`    ref: ${s.ref || 'HEAD'}`);
            lines.push(`    status: ${statusStr}`);
            lines.push('');
          }
        }

        say(lines);
        process.exit(0);
      }
      fail('usage: skopos sources sync|list');
    }

    if (cmd === 'config') {
      if (args._[1] === 'validate') {
        const r = runConfigValidate({ env, skoposRoot });
        const printWarnings = () => {
          if (!r.warnings.length) return;
          console.log(c.boldYellow(`warnings (${r.warnings.length}) — not blocking:`));
          for (const w of r.warnings) console.log(c.yellow(`  ! ${w}`));
        };
        if (!r.errors.length) {
          console.log(`config: OK (${r.existed ? r.path : 'no user config yet — defaults only'})`);
          printWarnings();
          process.exit(0);
        }
        console.log('config: INVALID');
        for (const e of r.errors) console.log(`  - ${e}`);
        printWarnings();
        process.exit(1);
      }
      fail('usage: skopos config validate');
    }

    if (cmd === 'models') {
      const sub = args._[1];

      if (sub === 'list') {
        const { models } = runModelsList();
        const lines = [];
        lines.push(fmt.header('SKOPOS MODELS', 'double'));
        lines.push('');
        lines.push(c.dim('  Informational only — platforms make the final routing decision.'));
        lines.push('');
        for (const m of models) {
          lines.push(c.bold(`  ${m.name}`) + c.dim(` (${m.family})`));
          lines.push(`    reasoning: ${m.reasoningDepth}   tool-use: ${m.toolUse}   concurrent-tools: ${m.concurrentTools}   cost: ${m.costTier}`);
          lines.push(`    best for: ${m.bestFor.join(', ')}`);
          lines.push('');
        }
        say(lines);
        process.exit(0);
      }

      if (sub === 'check') {
        const r = runModelsCheck({ env, skoposRoot });
        const lines = [];
        lines.push(fmt.header('SKOPOS MODELS CHECK', 'double'));
        lines.push('');
        if (!r.targets.length) {
          lines.push('  no targets enabled — run `skopos install` first.');
        }
        for (const res of r.results) {
          const tag = res.warnings.length ? c.boldYellow('⚠') : c.green('✔');
          lines.push(`  ${tag} [${res.target}] ${res.agent} → ${res.model || '(no model resolved)'}`);
          for (const w of res.warnings) lines.push(c.yellow(`      ! ${w}`));
        }
        lines.push('');
        lines.push(r.warnings.length
          ? c.boldYellow(`  ⚠ ${r.warnings.length} advisory warning(s) — informational, nothing was blocked.`)
          : c.boldGreen('  ✔ every resolved model meets its agent\'s declared requirements.'));
        say(lines);
        process.exit(0);
      }

      if (sub === 'signal') {
        const agentName = args._[2];
        const r = runModelsSignal({ env, skoposRoot, agentName, family: args.family });
        console.log(JSON.stringify(r, null, 2));
        process.exit(0);
      }

      if (sub === 'matrix') {
        const r = runModelsMatrix({ env, skoposRoot });
        const lines = [];
        lines.push(fmt.header('SKOPOS MODELS MATRIX', 'double'));
        lines.push('');
        lines.push(c.dim(`  Every known model against every agent, independent of current config.`));
        lines.push('');
        for (const row of r.matrix) {
          lines.push(c.bold(`  ${row.agent}`));
          const cellStrs = row.cells.map((cell) => {
            const tag = cell.warnings.length ? c.yellow('✗') : c.green('✔');
            return `${tag} ${cell.model}`;
          });
          lines.push(`    ${cellStrs.join('   ')}`);
        }
        say(lines);
        process.exit(0);
      }

      fail('usage: skopos models list|check|signal [<agent>] [--family claude|copilot]|matrix');
    }

    if (cmd === 'sor') {
      const sub = args._[1];
      if (!sub) fail('usage: skopos sor auth|test|publish|list|read');

      // Async commands
      if (sub === 'auth' || sub === 'test' || sub === 'publish' || sub === 'list' || sub === 'read') {
        (async () => {
          try {
            const loaded = configLib.loadConfig(env, skoposRoot);
            let result;

            if (sub === 'auth') {
              const action = args._[2];
              const system = args._[3];
              result = await runSorAuth({ env, skoposRoot, action, system });
              if (result.ok) console.log(JSON.stringify(result, null, 2));
              else fail(result.message);
            } else if (sub === 'test') {
              const system = args._[2];
              result = await runSorTest({ env, skoposRoot, system, log: console.error });
              if (result.ok) {
                console.log(`${c.green('✓')} system-of-record test passed`);
                if (result.checks) {
                  for (const check of result.checks) {
                    const status = check.ok ? c.green('✓') : c.red('✗');
                    console.log(`  ${status} ${check.name}: ${check.detail}`);
                  }
                }
              } else {
                fail(`test failed: ${result.message}`);
              }
            } else if (sub === 'publish') {
              const system = args._[2];
              const target = args._[3];
              const kind = args._[4];
              const feature = args._[5];
              const file = args._[6];
              if (!file) fail('usage: skopos sor publish <system> <target> <kind> <feature> <file>');
              result = await runSorPublish({ env, skoposRoot, system, target, kind, feature, file, log: console.error });
              if (result.ok) console.log(JSON.stringify(result, null, 2));
              else fail(result.message);
            } else if (sub === 'list') {
              const system = args._[2];
              const target = args._[3];
              result = await runSorList({ env, skoposRoot, system, target, log: console.error });
              if (result.ok) console.log(JSON.stringify(result, null, 2));
              else fail(result.message);
            } else if (sub === 'read') {
              const system = args._[2];
              const target = args._[3];
              const remoteId = args._[4];
              if (!remoteId) fail('usage: skopos sor read <system> <target> <remoteId>');
              result = await runSorRead({ env, skoposRoot, system, target, remoteId, log: console.error });
              if (result.ok) console.log(JSON.stringify(result, null, 2));
              else fail(result.message);
            }
            process.exit(0);
          } catch (e) {
            fail(e.message);
          }
        })();
        return;
      }

      fail(`unknown sor subcommand: ${sub}`);
    }

    console.error(`unknown command: ${cmd}\n`);
    console.log(USAGE);
    process.exit(1);
  } catch (e) {
    fail(e.message);
  }
}

main();
